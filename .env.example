# radio.cn 云听网页端接口签名密钥(从前端 JS 里取), 必填。
# 复制成 .env 后填真值; .env 已在 .gitignore 里。
SIGN_KEY=

# 可选: 备用网关 https://ytmsotherout.radio.cn
# API_BASE=https://ytmsout.radio.cn
#
# 可选: 同一频道复用已签地址的最长秒数 / 目录全量刷新间隔
# 令牌实测有效 ≥45 分钟, 120 秒足够保守; 调得太小会让「切台」每次都要重签
# RESIGN_WINDOW=120
# CATALOG_TTL=900
#
# 可选: 冷启动与自愈相关, 一般不用改
# BUILD_WAIT=8          # 目录构建中单个请求最多等多久(秒), 需小于客户端探活超时 12s
# BUILD_CONCURRENCY=8   # 建目录时的并发抓取数
# REBUILD_COOLDOWN=300  # 目录疑似失效时全量重建的冷却(秒)
# BUILD_RETRY_GAP=20    # 建表失败后的重试间隔(秒)
# PL_REUSE=5            # probe 拉到的播放列表给 /m3u8 复用的秒数
